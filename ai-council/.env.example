# Обычно этот файл заполняет install.sh. Вручную: скопируйте в .env и впишите значения.

# OpenRouter — доступ ко всем моделям: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Telegram-бот: токен от @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Кому можно пользоваться ботом: Telegram ID через запятую.
# Свой ID бот покажет, если написать ему без доступа.
TELEGRAM_ALLOWED_USERS=

# Веб-интерфейс: none — нет, tunnel — через SSH-туннель, https — из интернета с паролем
WEB_MODE=none
# Адрес для https: свой домен или бесплатный вида 1-2-3-4.sslip.io
DOMAIN=
WEB_USER=admin
WEB_PASSWORD=
