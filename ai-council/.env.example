# Скопируйте в .env и вставьте ключ с https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Telegram-бот (python -m council telegram)
# Токен — у @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Кому можно пользоваться ботом: Telegram ID через запятую.
# Свой ID бот покажет, если написать ему без доступа.
TELEGRAM_ALLOWED_USERS=
